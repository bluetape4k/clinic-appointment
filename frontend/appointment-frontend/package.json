{
  "name": "appointment-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "bundle:verify": "node scripts/validate-mobile-bundle.mjs",
    "pwa:verify": "node scripts/validate-pwa-contract.mjs",
    "bridge:verify": "node scripts/validate-native-webview-bridge.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:bundle": "node --test scripts/validate-mobile-bundle.test.mjs",
    "test:pwa": "node --test scripts/validate-pwa-contract.test.mjs",
    "test:bridge": "node --test scripts/validate-native-webview-bridge.test.mjs",
    "docs:verify": "node ../../scripts/validate-frontend-contract.mjs",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android"
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/service-worker": "^22.1.3",
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "chart.js": "^4.5.1",
    "hono": "^4.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/pwa": "^22.1.5",
    "@capacitor/cli": "8.5.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  }
}
