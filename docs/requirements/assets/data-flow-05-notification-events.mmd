flowchart LR
    CMD["Appointment command"] -->|"same transaction"| OUTBOX[("Appointment + minimal notification outbox")]
    OUTBOX --> GATE{"SHADOW / CANARY / ACTIVE / PAUSED"}
    GATE -->|"transitional route"| EVENT["Spring event listener"]
    GATE -->|"background route"| WORKER["Outbox dispatcher"]
    EVENT --> CLAIM["Conditional claim of the exact outbox row"]
    WORKER --> CLAIM
    CLAIM --> PROFILE["Resolve current contact, language, and consent"]
    PROFILE --> TEMPLATE["Render approved typed template in memory"]
    TEMPLATE --> PROVIDER["Provider call with deterministic idempotency key"]
    PROVIDER --> TERMINAL["Fenced terminal update and identifier redaction"]
    TERMINAL --> RETENTION["Bounded status-specific retention"]

    NOTE["No persisted name, contact, rendered body, provider payload, or raw error"]
    PROFILE -.-> NOTE
    TERMINAL -.-> NOTE
